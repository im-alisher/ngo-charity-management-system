# Normalise line endings to LF in the repository; check out LF on every platform.
* text=auto eol=lf

# Windows-only scripts must keep CRLF.
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.ps1   text eol=crlf

# Binary assets are never diffed or line-ending converted.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
