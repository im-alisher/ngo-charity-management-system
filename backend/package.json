{
  "name": "charity-management-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS + Prisma REST API for the NGO Charity Management System.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "npm run build && concurrently -k -n TSC,API -c gray,green \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --enable-source-maps dist/main.js\"",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "user:create": "tsx src/scripts/create-user.ts",
    "user:list": "tsx src/scripts/list-users.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.0",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "^18.0.4",
    "pg": "^8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "@types/pg": "^8.23.1",
    "concurrently": "9.2.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "rimraf": "6.0.1",
    "source-map-support": "0.5.21",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
