# ---------------------------------------------------------------------------
# Backend environment variables
#
# Copy this file to `.env` and fill in the values below:
#   cp .env.example .env      (macOS / Linux / Git Bash)
#   copy .env.example .env    (Windows CMD / PowerShell)
#
# `.env` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# Runtime ---------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Base path all REST routes are mounted under (e.g. /api/donors).
API_PREFIX=api

# Database --------------------------------------------------------------------
# PostgreSQL connection string used by Prisma Migrate and by the API at runtime.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/charity?schema=public"

# CORS ------------------------------------------------------------------------
# Comma-separated list of allowed browser origins. The Vite dev server runs on
# 5173 by default.
CORS_ORIGIN=http://localhost:5173

# Authentication --------------------------------------------------------------
# Secret used to sign JWT access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters in production.
JWT_SECRET=replace-this-with-a-long-random-secret

# Token lifetime. Accepts a number of seconds or a time span such as 30m, 12h, 7d.
JWT_EXPIRES_IN=1d
