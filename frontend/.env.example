# ---------------------------------------------------------------------------
# Frontend environment variables
#
# Copy this file to `.env.local`:
#   cp .env.example .env.local
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never put a secret here: everything in `src/` ships to the client.
# ---------------------------------------------------------------------------

# Base URL of the REST API.
#
# Leave this unset in development: `vite.config.ts` proxies `/api` to
# http://localhost:3000, so the app stays same-origin and no CORS round trip
# is needed. Set it when the API lives on another host, for example:
#   VITE_API_BASE_URL=https://api.charity.example.org/api
VITE_API_BASE_URL=/api
